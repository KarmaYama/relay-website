# Netlify redirects.
# The Terms of Service live at /legal for historical reasons (existing inbound
# links point there), but /terms is what people actually guess and type.
/terms      /legal      301
/tos        /legal      301
/disputes   /legal#disputes   301
/licence    /eula       301
/license    /eula       301
/cookies    /data-policy      301

# A job invitation opened without the app installed.
#
# With Relay installed Android never gets here — it opens the app on the job.
# Without it, the link has to land somewhere that explains what it is and offers
# the download, rather than a 404 handed to somebody who has never heard of us
# by a runner they are deciding whether to trust.
/j/*        /invite.html    200
